, "e3": {"t": 54.394, "d": 2.982, "quem": "edson", "leg": "Lá embaixo tem o depósito. Porta de aço. Vem.", "arq": "e3"}, "t5": {"t": 57.676, "d": 1.644, "quem": "tu", "leg": "E o Léo?", "arq": "t5"}, "LEOVOLTA": {"t": 59.42, "d": 2.2}, "l4": {"t": 61.62, "d": 1.299, "quem": "leo", "leg": "Tô aqui. Tô aqui.", "arq": "l4"}, "t6": {"t": 63.119, "d": 2.489, "quem": "tu", "leg": "Já? E o carregador?", "arq": "t6"}, "l5": {"t": 65.808, "d": 1.548, "quem": "leo", "leg": "Deixa. Vamo.", "arq": "l5"}, "BAM": {"t": 67.556, "d": 1.4}, "e4": {"t": 68.956, "d": 0.449, "quem": "edson", "leg": "CORRE!", "arq": "e4"}, "CORRE": {"t": 69.506, "d": 4.6}, "ESCADA": {"t": 74.106, "d": 3.4}, "CORREDOR": {"t": 77.506, "d": 2.4}, "m0": {"t": 79.906, "d": 2.382, "quem": "marcos", "leg": "Alguém tem sinal? Eu não tenho sinal!", "arq": "m0"}, "n0": {"t": 82.588, "d": 4.582, "quem": "neide", "leg": "Aqui embaixo ninguém tem, moço. Nunca teve.", "arq": "n0"}, "m1": {"t": 87.47, "d": 1.538, "quem": "marcos", "leg": "Então como chegou o alerta?", "arq": "m1"}, "FECHA": {"t": 89.308, "d": 1.8}, "e5": {"t": 91.308, "d": 10.382, "quem": "edson", "leg": "Um, dois, três, quatro... e eu. Cinco. Ninguém abre essa porta até a central liberar. Combinado?", "arq": "e5"}, "m2": {"t": 101.99, "d": 2.292, "quem": "marcos", "leg": "Combinado nada. Eu tenho filho em casa.", "arq": "m2"}, "e6": {"t": 104.582, "d": 2.192, "quem": "edson", "leg": "Todo mundo tem alguém em casa.", "arq": "e6"}, "SENTA": {"t": 107.074, "d": 1.5}, "t7": {"t": 108.774, "d": 1.582, "quem": "tu", "leg": "Tá bem?", "arq": "t7"}, "l6": {"t": 110.756, "d": 0.342, "quem": "leo", "leg": "Tô.", "arq": "l6"}, "t8": {"t": 111.498, "d": 2.237, "quem": "tu", "leg": "Tá esquisito, cara.", "arq": "t8"}, "l7": {"t": 114.035, "d": 1.996, "quem": "leo", "leg": "Tô com frio. Só isso.", "arq": "l7"}, "t9": {"t": 116.832, "d": 2.332, "quem": "tu", "leg": "A senhora já viu isso antes, né?", "arq": "t9"}, "n1": {"t": 119.464, "d": 6.604, "quem": "neide", "leg": "Antes de ser shopping, isso aqui era o hospital. Eu era da limpeza lá também.", "arq": "n1"}, "t10": {"t": 126.468, "d": 1.228, "quem": "tu", "leg": "E?", "arq": "t10"}, "n2": {"t": 128.096, "d": 9.884, "quem": "neide", "leg": "Teve uma noite igual. Mandaram trancar a ala de baixo... De manhã, abriram. Faltava gente.", "arq": "n2"}, "m3": {"t": 138.28, "d": 1.756, "quem": "marcos", "leg": "Faltava como?", "arq": "m3"}, "n3": {"t": 140.536, "d": 3.328, "quem": "neide", "leg": "Faltava. E sobrava.", "arq": "n3"}, "SILENCIO": {"t": 144.164, "d": 2.0}, "TOC": {"t": 146.164, "d": 2.2}, "mae0": {"t": 148.564, "d": 6.07, "quem": "mae", "leg": "Filho? Filho, sou eu... abre, pelo amor de Deus. Eu tô machucada.", "arq": "mae0"}, "LEVANTA": {"t": 154.934, "d": 1.2}, "t11": {"t": 156.134, "d": 4.83, "quem": "tu", "leg": "Ela tá em casa... ela nem sabe que eu tô aqui.", "arq": "t11"}, "mae1": {"t": 161.464, "d": 3.252, "quem": "mae", "leg": "Sei sim, filho. Abre.", "arq": "mae1"}, "VISOR": {"t": 165.016, "d": 1.8}, "l8": {"t": 167.016, "d": 1.618, "quem": "leo", "leg": "Abre. É tua mãe.", "arq": "l8"}, "FIM": {"t": 168.833, "d": 1.8}}}