3, "d": 0.72, "quem": "tu", "leg": "E o Léo?", "arq": "t5"}, "LEOVOLTA": {"t": 58.65, "d": 2.2}, "l4": {"t": 60.85, "d": 1.71, "quem": "leo", "leg": "Tô aqui. Tô aqui.", "arq": "l4"}, "t6": {"t": 62.76, "d": 1.63, "quem": "tu", "leg": "Já? E o carregador?", "arq": "t6"}, "l5": {"t": 64.59, "d": 0.89, "quem": "leo", "leg": "Deixa. Vamo.", "arq": "l5"}, "BAM": {"t": 65.68, "d": 1.4}, "e4": {"t": 67.08, "d": 0.48, "quem": "edson", "leg": "CORRE!", "arq": "e4"}, "CORRE": {"t": 67.66, "d": 4.6}, "ESCADA": {"t": 72.26, "d": 3.4}, "CORREDOR": {"t": 75.66, "d": 2.4}, "m0": {"t": 78.06, "d": 2.47, "quem": "marcos", "leg": "Alguém tem sinal? Eu não tenho sinal!", "arq": "m0"}, "n0": {"t": 80.83, "d": 3.295, "quem": "neide", "leg": "Aqui embaixo ninguém tem, moço. Nunca teve.", "arq": "n0"}, "m1": {"t": 84.425, "d": 1.32, "quem": "marcos", "leg": "Então como chegou o alerta?", "arq": "m1"}, "FECHA": {"t": 86.045, "d": 1.8}, "e5": {"t": 88.045, "d": 9.72, "quem": "edson", "leg": "Um, dois, três, quatro... e eu. Cinco. Ninguém abre essa porta até a central liberar. Combinado?", "arq": "e5"}, "m2": {"t": 98.065, "d": 2.25, "quem": "marcos", "leg": "Combinado nada. Eu tenho filho em casa.", "arq": "m2"}, "e6": {"t": 100.615, "d": 1.95, "quem": "edson", "leg": "Todo mundo tem alguém em casa.", "arq": "e6"}, "SENTA": {"t": 102.865, "d": 1.5}, "t7": {"t": 104.565, "d": 0.6, "quem": "tu", "leg": "Tu tá bem?", "arq": "t7"}, "l6": {"t": 105.565, "d": 0.37, "quem": "leo", "leg": "Tô.", "arq": "l6"}, "t8": {"t": 106.335, "d": 1.27, "quem": "tu", "leg": "Tu tá esquisito.", "arq": "t8"}, "l7": {"t": 107.905, "d": 1.45, "quem": "leo", "leg": "Tô com frio. Só isso.", "arq": "l7"}, "t9": {"t": 110.155, "d": 2.58, "quem": "tu", "leg": "A senhora já viu isso antes, né?", "arq": "t9"}, "n1": {"t": 113.035, "d": 5.505, "quem": "neide", "leg": "Antes de ser shopping, isso aqui era o hospital. Eu era da limpeza lá também.", "arq": "n1"}, "t10": {"t": 118.94, "d": 0.63, "quem": "tu", "leg": "E?", "arq": "t10"}, "n2": {"t": 119.97, "d": 6.35, "quem": "neide", "leg": "Teve uma noite igual. Mandaram trancar a ala de baixo... De manhã, abriram. Faltava gente.", "arq": "n2"}, "m3": {"t": 126.62, "d": 1.1, "quem": "marcos", "leg": "Faltava como?", "arq": "m3"}, "n3": {"t": 128.22, "d": 1.735, "quem": "neide", "leg": "Faltava. E sobrava.", "arq": "n3"}, "SILENCIO": {"t": 130.255, "d": 2.0}, "TOC": {"t": 132.255, "d": 2.2}, "mae0": {"t": 134.655, "d": 5.98, "quem": "mae", "leg": "Filho? Filho, sou eu... abre, pelo amor de Deus. Eu tô machucada.", "arq": "mae0"}, "LEVANTA": {"t": 140.935, "d": 1.2}, "t11": {"t": 142.135, "d": 3.7, "quem": "tu", "leg": "Ela tá em casa... ela nem sabe que eu tô aqui.", "arq": "t11"}, "mae1": {"t": 146.335, "d": 2.6, "quem": "mae", "leg": "Sei sim, filho. Abre.", "arq": "mae1"}, "VISOR": {"t": 149.235, "d": 1.8}, "l8": {"t": 151.235, "d": 2.26, "quem": "leo", "leg": "Abre. É tua mãe.", "arq": "l8"}, "FIM": {"t": 153.695, "d": 1.8}}}